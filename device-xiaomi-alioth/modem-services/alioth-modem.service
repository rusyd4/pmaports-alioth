[Unit]
Description=Bring up the SDX55 modem
After=local-fs.target tqftpserv.service alioth-modem-firmware.service
Wants=tqftpserv.service alioth-modem-firmware.service
Requires=alioth-modem-firmware.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/modem-up.sh
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
