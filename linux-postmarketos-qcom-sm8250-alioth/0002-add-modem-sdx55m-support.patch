+/*
+ * Downstream (mhi_qcom.c, MHI_CB_EE_MISSION_MODE) forces a suspend the moment
+ * the device reaches mission mode - the comment there reads "so device can
+ * switch to mission mode pcie phy settings" - and resumes right after.
+ * Mainline never does it.  Without the cycle this modem reaches mission mode,
+ * answers every QMI service, and still refuses to enable its radio with
+ * DeviceNotReady, so something on its side waits for the link to go down and
+ * come back.
+ */
+static void mhi_pci_mission_mode_work(struct work_struct *work)
+{
+	struct mhi_pci_device *mhi_pdev = container_of(work, struct mhi_pci_device,
+						       mission_mode_work);
+	struct pci_dev *pdev = to_pci_dev(mhi_pdev->mhi_cntrl.cntrl_dev);
+	struct device *dev = &pdev->dev;
+	int err;
+
+	/* let the mission mode transition finish before pulling the link down */
+	msleep(200);
+
+
+	/* every control channel already has buffers posted by now */
+	mhi_pdev->force_suspend = true;
+	err = mhi_pci_runtime_suspend(dev);
+	mhi_pdev->force_suspend = false;
+	if (err) {
+		return;
+	}
+
+	/* the PCI core would do this part on a real runtime suspend */
+	pci_save_state(pdev);
+	pci_set_power_state(pdev, PCI_D3hot);
+	msleep(50);
+	pci_set_power_state(pdev, PCI_D0);
+	pci_restore_state(pdev);
+
+	err = mhi_pci_runtime_resume(dev);
+}
