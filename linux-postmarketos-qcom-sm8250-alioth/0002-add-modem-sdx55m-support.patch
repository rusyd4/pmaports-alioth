+int qcom_pcie_cycle_endpoint_reset(struct device *dev);
+int qcom_pcie_cycle_endpoint_reset(struct device *dev)
+{
+	struct qcom_pcie *pcie = NULL;
+	struct dw_pcie *pci;
+	struct dw_pcie_rp *pp;
+	int ret, retries;
+
+	if (!dev) {
+		struct device_node *np = of_find_node_by_path("/soc@0/pcie@1c10000");
+		if (np) {
+			struct platform_device *pdev = of_find_device_by_node(np);
+			of_node_put(np);
+			if (pdev)
+				pcie = platform_get_drvdata(pdev);
+		}
+	} else {
+		while (dev) {
+			if (dev->driver && dev->driver->name && !strcmp(dev->driver->name, "qcom-pcie")) {
+				pcie = dev_get_drvdata(dev);
+				break;
+			}
+			dev = dev->parent;
+		}
+	}
+
+	if (!pcie)
+		return -ENODEV;
+
+	pci = pcie->pci;
+	pp = &pci->pp;
+
+	dev_info(pcie->pci->dev, "Resetting PCIe host & retraining link...\n");
+
+	qcom_pcie_host_deinit(pp);
+	msleep(200);
+
+	ret = qcom_pcie_host_init(pp);
+	if (ret) {
+		dev_err(pcie->pci->dev, "Host init failed: %d\n", ret);
+		return ret;
+	}
+
+	dw_pcie_setup_rc(pp);
+
+	ret = dw_pcie_start_link(pci);
+	if (ret) {
+		dev_err(pcie->pci->dev, "Start link failed: %d\n", ret);
+		return ret;
+	}
+
+	for (retries = 0; retries < 35; retries++) {
+		if (dw_pcie_link_up(pci))
+			break;
+		msleep(100);
+	}
+
+	if (!dw_pcie_link_up(pci)) {
+		dev_err(pcie->pci->dev, "PCIe link retraining timed out\n");
+		return -ETIMEDOUT;
+	}
+
+	dev_info(pcie->pci->dev, "PCIe link retraining succeeded!\n");
+	return 0;
+}
+EXPORT_SYMBOL_GPL(qcom_pcie_cycle_endpoint_reset);
+
+static ssize_t cycle_reset_store(struct device *dev,
+				 struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	int ret = qcom_pcie_cycle_endpoint_reset(dev);
+	if (ret)
+		return ret;
+	return count;
+}
+static DEVICE_ATTR_WO(cycle_reset);
