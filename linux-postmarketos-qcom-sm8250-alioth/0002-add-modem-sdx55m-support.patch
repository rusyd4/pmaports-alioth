+/*
+ * The device posts a bandwidth request here and waits for the host to write a
+ * result to the bandwidth doorbell.  Ported from the downstream
+ * mhi_process_bw_scale_ev_ring().
+ */
+void mhi_bw_scale_work(struct work_struct *work)
+{
+	struct mhi_controller *mhi_cntrl = container_of(work,
+						struct mhi_controller,
+						bw_scale_work);
+	struct device *dev = &mhi_cntrl->mhi_dev->dev;
+	struct mhi_link_info link_info = mhi_cntrl->bw_scale_req;
+	int result, ret;
+
+	ret = mhi_cntrl->bw_scale(mhi_cntrl, &link_info);
+	if (!ret)
+		mhi_cntrl->mhi_link_info = link_info;
+
+	result = ret ? MHI_BW_SCALE_NACK : 0;
+
+	read_lock_bh(&mhi_cntrl->pm_lock);
+	if (likely(MHI_DB_ACCESS_VALID(mhi_cntrl)))
+		mhi_write_reg(mhi_cntrl, mhi_cntrl->bw_scale_db, 0,
+			      MHI_BW_SCALE_RESULT(result, link_info.sequence_num));
+	read_unlock_bh(&mhi_cntrl->pm_lock);
+
+	dev_info(dev, "Bandwidth request seq %d answered: %s (%d)\n",
+		 link_info.sequence_num, ret ? "NACK" : "ACK", ret);
+}
