+/*
+ * Warm reset of the modem through its own PMIC.  Register layout and sequence
+ * are qpnp_pon_modem_pwr_off(PON_POWER_OFF_WARM_RESET) from the downstream
+ * tree; the base comes from the stock overlay's qcom,power-on@800.
+ */
+#define SDX_PON_BASE			0x800
+#define SDX_PON_SW_RST_S2_CTL		(SDX_PON_BASE + 0x62)
+#define SDX_PON_SW_RST_S2_CTL2		(SDX_PON_BASE + 0x63)
+#define SDX_PON_SW_RST_GO		(SDX_PON_BASE + 0x64)
+#define SDX_PON_WARM_RESET		0x01
+#define SDX_PON_RESET_EN		0x80
+#define SDX_PON_GO			0xa5
+
+static struct spmi_device *sdx_pon_sdev;
